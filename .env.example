# ==========================================
# AI-Powered DevSecOps Security Platform - Environment Configuration
# ==========================================

# ==========================================
# Database Configuration
# ==========================================
# Options: sqlite (default) or postgresql
DATABASE_TYPE=postgresql
DATABASE_URL=postgresql://ai_devsecops:your_secure_password@postgres:5432/ai_devsecops
POSTGRES_USER=ai_devsecops
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=ai_devsecops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==========================================
# Security Configuration
# ==========================================
# JWT Secret Key - required in production
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production

# Optional first administrator. Leave unset after initial provisioning.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# JWT Token Expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# CORS Configuration
# ==========================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1

# ==========================================
# AI Configuration
# ==========================================
# Enable AI features (true/false)
AI_ENABLED=false

# AI Provider: openai or knowledge_base
AI_PROVIDER=openai

# OpenAI API Configuration (if using openai provider)
AI_API_KEY=your_openai_api_key_here
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-3.5-turbo
AI_REQUEST_TIMEOUT=30

# ==========================================
# Frontend Configuration
# ==========================================
# API Base URL for frontend (auto-detected if not set)
# VITE_API_BASE_URL=http://127.0.0.1:8000

# ==========================================
# Upload Configuration
# ==========================================
# Maximum file size in bytes (5MB default)
MAX_FILE_SIZE=5242880

# ==========================================
# Rate Limiting
# ==========================================
# Requests per minute for API endpoints
RATE_LIMIT_PER_MINUTE=60

# ==========================================
# Logging Configuration
# ==========================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==========================================
# Email Configuration
# ==========================================
# Email service for sending security reports
EMAIL_ADDRESS=your-email@example.com
EMAIL_PASSWORD=your-email-app-password
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
